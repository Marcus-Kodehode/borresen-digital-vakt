{
  "ci": {
    "collect": {
      "url": [
        "https://www.borresendigital.no/nb",
        "https://www.borresendigital.no/en",
        "https://www.borresendigital.no/nb/tjenester",
        "https://www.borresendigital.no/nb/blogg",
        "https://www.borresendigital.no/nb/kontakt"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
